# ==========================================================
# FAMS Environment Variables — TEMPLATE
# Copy to .env.development / .env.staging / .env.production
# and fill in real values
# ==========================================================

# ── Application ──────────────────────────────────────────
APP_NAME="Fiber Asset Management System"
APP_ENV="development"              # development | staging | production
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
NODE_ENV=development
APP_PORT=3000

# ── Database (PostgreSQL 17 + PostGIS) ───────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fams_dev
DATABASE_USER=fams_user
DATABASE_PASSWORD=change_me
DATABASE_URL=postgresql://fams_user:change_me@localhost:5432/fams_dev?schema=public

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=generate_random_64_char_hex_string
JWT_REFRESH_SECRET=generate_random_64_char_hex_string
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── MinIO (S3-Compatible Object Storage) ─────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_PHOTOS=photos
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_EXPORTS=exports
MINIO_USE_SSL=false

# ── BullMQ ───────────────────────────────────────────────
BULL_REDIS_HOST=${REDIS_HOST}
BULL_REDIS_PORT=${REDIS_PORT}
BULL_REDIS_PASSWORD=${REDIS_PASSWORD}

# ── Swagger ──────────────────────────────────────────────
SWAGGER_ENABLED=true               # false in production
SWAGGER_TITLE=FAMS API
SWAGGER_DESCRIPTION=Fiber Asset Management System API
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# ── Grafana ──────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME="user@example.com"
SMTP_PASSWORD="password"

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"

# ── WhatsApp ─────────────────────────────────────────────
WHATSAPP_API_KEY="your_whatsapp_api_key"

# ── AI ───────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="AIza..."

# ── GIS ──────────────────────────────────────────────────
MAPTILER_API_KEY="your_maptiler_key"

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
